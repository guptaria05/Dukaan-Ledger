# PostgreSQL connection string. Use a private managed database in production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/dukaan_ledger
# Comma-separated exact frontend origins, e.g. https://dukaan.example.com,http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
# OAuth 2.0 Web client ID from Google Cloud Console (Google Identity Services).
GOOGLE_CLIENT_ID=
# Set to production behind HTTPS. Secure cookies are enabled automatically in production.
NODE_ENV=development
PORT=4000
